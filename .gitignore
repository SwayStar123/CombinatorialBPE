# environments / caches
.venv/
__pycache__/
*.egg-info/
build/
dist/
.pytest_cache/
.pytest_tmp/

# downloaded corpora and token caches (see scripts/download_data.py)
/data/

# all trained tokenizers from the benchmarks (~150 MB); a few are shipped in pretrained/
results/tokenizers/
results/*.log

# scratch
figures/_preview*

# Rust build output (cargo build --release in each native/* crate)
native/*/target/
native/*/target_dev/
# frontier tokenizer files (downloaded by the user, see experiments/bench_frontier.py)

# temp files (cbpe sets tempfile.tempdir here, see cbpe/__init__.py)
/tmp/

# third-party tokenizer files for comparisons (downloaded), and the bench run log
results/frontier_tok/
results/unrestricted.json
